{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "nuqs": "^2.10.0",
    "react": "latest",
    "react-dom": "latest",
    "viem": "latest",
    "wagmi": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@wagmi/cli": "latest",
    "oxfmt": "^0.12.0",
    "oxlint": "^1.13.0",
    "typescript": "latest",
    "vite": "latest"
  }
}
